# HTTP port for `npm run dev` and `npm start` (the built preview server).
# Unset => 3040. On the server the CD workflow exports it instead.
# PORT=3040

# Extra `Host:` headers the preview server accepts, comma separated.
# Unset => abituriyent.bdu.co.az (localhost is always allowed).
# ALLOWED_HOSTS=abituriyent.bdu.co.az

# Copy to `.env` and set your AbituriBack deployment origin.
# When empty/unset, the app runs against the built-in offline mock.
VITE_API_BASE=https://abituriback.onrender.com

# Cloudflare Turnstile SITE key (public — safe in the frontend bundle).
# Backend owner: Cloudflare dashboard -> Turnstile -> your widget -> "Site Key".
# It must belong to the same widget whose Secret Key the backend has in
# TURNSTILE_SECRET_KEY, or every operator request comes back 403.
# Unset => the "Contact an operator" action is hidden (it could only fail).
# Cloudflare's always-passes test key is 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
